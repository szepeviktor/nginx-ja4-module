ngx_addon_name=ngx_http_ja4_module

if [ "$HTTP_SSL" != YES ]; then
    echo "$ngx_addon_name requires --with-http_ssl_module"
    exit 1
fi

ngx_module_type=HTTP
ngx_module_name=ngx_http_ja4_module
ngx_module_srcs="$ngx_addon_dir/ngx_http_ja4_module.c $ngx_addon_dir/ja4.c"
ngx_module_incs="$ngx_addon_dir"
ngx_module_deps="$ngx_addon_dir/ja4.h"
ngx_module_libs="-lssl -lcrypto"
. auto/module
